# ==============================================================================
# ZeroLeak — Environment Configuration Template
# GDG DevFest Mien Trung 2026
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Threat Intel & Cloud Sandbox (apps/sandbox-api)
# ------------------------------------------------------------------------------
# Google Gemini API Key for Visual Phishing & Voice Deepfake Analysis
GEMINI_API_KEY=your_gemini_api_key_here

# Smart Model Router: gemini-3.5-flash-lite (dev/test) -> gemini-3.8-flash (pitching demo)
GEMINI_MODEL_VISION=gemini-3.5-flash-lite

# Task 2.4: Gemini handles both scam content and synthetic voice estimation.
# Set hybrid to compare with the previous Gemini-content + local V3 implementation.
VOICE_ANALYSIS_STRATEGY=gemini

# Voice model routing: Live API (WebSocket) first, generateContent for Flash fallback.
GEMINI_MODEL_VOICE=gemini-3.8-live-extended-thinking
GEMINI_MODEL_VOICE_LIVE_FALLBACK=gemini-3.8-live
GEMINI_MODEL_VOICE_FALLBACK=gemini-3.5-flash-lite
# Optional review override; empty inherits the primary model and the same fallback chain.
GEMINI_MODEL_VOICE_REVIEW=
# Required when NODE_ENV=production. Enter the same token in Voice > Kết nối dịch vụ.
# Leave empty only for local development (the server binds to 127.0.0.1).
VOICE_API_TOKEN=
# Optional extra browser origins, comma-separated. Chrome extension and localhost are allowed.
VOICE_ALLOWED_ORIGINS=
# Optional local acoustic service, used only with VOICE_ANALYSIS_STRATEGY=hybrid.
# Run with scripts/voice_acoustic.py after warmup.
# Only numeric loopback HTTP addresses are accepted; audio is never sent to a remote model URL.
VOICE_ACOUSTIC_URL=
# Optional overrides. Defaults: ~/Library/Caches/ZeroLeak/voice and its venv/bin/python.
VOICE_MODEL_CACHE=
VOICE_PYTHON=

# Google Safe Browsing API v4 Key for fast blacklist lookup
GOOGLE_SAFE_BROWSING_API_KEY=your_google_safe_browsing_api_key_here

# Server Port for Hono + Playwright Sandbox
PORT=8080
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. Browser Extension (apps/extension)
# ------------------------------------------------------------------------------
# URL of the Cloud Sandbox API (Local development or deployed Google Cloud Run URL)
SANDBOX_API_URL=http://localhost:8080

# ------------------------------------------------------------------------------
# 3. Firebase Firestore Realtime Sync (apps/dashboard & apps/extension)
# ------------------------------------------------------------------------------
# Firebase Web Client Configuration (Used for realtime policy sync and telemetry)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyExampleKey1234567890abcdef
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=zeroleak-security.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=zeroleak-security
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=zeroleak-security.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# Optional Backend Admin SDK Credentials (JSON format)
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}

