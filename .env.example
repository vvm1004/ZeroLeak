# ------------------------------------------------------------------------------
# 1. AI Threat Intel & Cloud Sandbox (apps/sandbox-api)
# ------------------------------------------------------------------------------
# Google Gemini 3.5 Flash Lite API Key for Visual Phishing & Impersonation Analysis
GEMINI_API_KEY=your_gemini_api_key_here

# Google Web Risk API Key (Optional Threat Intel Lookup)
GOOGLE_WEBRISK_API_KEY=your_google_webrisk_api_key_here

# Server Port for Hono + Playwright Sandbox
PORT=8080
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. Browser Extension (apps/extension)
# ------------------------------------------------------------------------------
# URL of the Cloud Sandbox API (Local development or deployed Google Cloud Run URL)
SANDBOX_API_URL=http://localhost:8080

# ------------------------------------------------------------------------------
# 3. Firebase Firestore Realtime Sync (apps/dashboard & apps/extension)
# ------------------------------------------------------------------------------
# Firebase Web Client Configuration (Used for realtime policy sync and telemetry)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyExampleKey1234567890abcdef
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=zeroleak-phishguard.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=zeroleak-phishguard
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=zeroleak-phishguard.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# Optional Backend Admin SDK Credentials (JSON format)
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}

