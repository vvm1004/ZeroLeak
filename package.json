{
  "name": "zeroleak",
  "version": "1.0.0",
  "private": true,
  "description": "ZeroLeak - Hybrid Edge-Cloud Security Platform (On-Device DLP & Threat Sandbox)",
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev:extension": "pnpm --filter @zeroleak/extension dev",
    "dev:sandbox": "pnpm --filter @zeroleak/sandbox-api dev",
    "dev:voice-detector": "pnpm --filter @zeroleak/sandbox-api exec tsx scripts/start-voice-detector.ts",
    "dev:dashboard": "pnpm --filter @zeroleak/dashboard dev",
    "build:extension": "pnpm --filter @zeroleak/extension build",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test:voice:e2e": "playwright test --config tests/voice.playwright.config.ts",
    "dev:voice-extended": "VOICE_ANALYSIS_STRATEGY=gemini GEMINI_MODEL_VOICE=gemini-3.8-live-extended-thinking GEMINI_MODEL_VOICE_REVIEW=gemini-3.8-live-extended-thinking GEMINI_MODEL_VOICE_LIVE_FALLBACK=gemini-3.8-live-extended-thinking GEMINI_MODEL_VOICE_FALLBACK=gemini-3.8-live-extended-thinking pnpm dev:sandbox",
    "check:voice-demo": "pnpm --filter @zeroleak/sandbox-api exec tsx scripts/check-voice-demo.ts"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.13.1",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  }
}
