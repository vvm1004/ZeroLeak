  "private": true,
  "description": "Hybrid Edge-Cloud Security Platform (ZeroLeak On-Device DLP & PhishGuard Visual Phishing Sandbox)",
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev:extension": "pnpm --filter @zeroleak/extension dev",
